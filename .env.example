# Copy to .env and fill in. .env is gitignored (invariant 11).

# Matches docker-compose.yml.
PG_DSN=postgresql://vdel:vdel@localhost:5433/vdel

# Fine-grained or classic PAT with read access to the repos being collected.
GITHUB_TOKEN=

# M3. Listed here so the seam is visible; unused until the LLM Gateway exists.
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=

# M3, D-031. Only read when LLM_PROVIDER=nvidia. Free-tier NVIDIA-hosted inference
# (integrate.api.nvidia.com) -- treat as prototype access with rate limits, not a
# production guarantee. Never a real key here.
NVIDIA_API_KEY=

# M3, D-032 (supersedes D-023). Only read when LLM_PROVIDER=google. Google AI Studio /
# Gemini. Deliberately its own variable, not the SDK's own default GEMINI_API_KEY -- the
# gateway never falls back to that name. Never a real key here.
GOOGLE_API_KEY=

# Feature window, in days. Matches learner_features.window_days.
FEATURE_WINDOW_DAYS=14
