# PostgreSQL connection
PG_DSN=postgresql://vdel_user:vdel_password@localhost:5432/vdel

# GitHub API
GITHUB_TOKEN=your_github_token_here

# LLM Provider and model
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your_api_key_here

# Optional: for OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Airflow
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__DAGS_FOLDER=./dags
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://vdel_user:vdel_password@localhost:5432/airflow

# Feature computation window
FEATURE_WINDOW_DAYS=14

# Development
DEBUG=false
