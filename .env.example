# Copy to .env and fill in. .env is gitignored (invariant 11). Names only: no value is ever
# committed here. Check yours with `python -m scripts.doctor`, which prints names, never values.
# Optional variables are commented out on purpose: a BLANK value is not the same as an unset one
# (LLM_PROVIDER= or FEATURE_WINDOW_DAYS= would crash on import). Remove the # only to set a value.

# Postgres connection string; the compose file in this repo publishes the database on port 5433.
PG_DSN=

# GitHub token used by the collector, the grader's checkout and the delivery scripts (classic token with the repo and workflow scopes).
GITHUB_TOKEN=

# Which LLM provider the gateway uses: anthropic | openai | google | nvidia (default anthropic).
# LLM_PROVIDER=

# Key for LLM_PROVIDER=anthropic; any key that is present can also serve as a fallback provider.
# ANTHROPIC_API_KEY=

# Key for LLM_PROVIDER=openai.
# OPENAI_API_KEY=

# Key for LLM_PROVIDER=google (Gemini through Google AI Studio).
# GOOGLE_API_KEY=

# Key for LLM_PROVIDER=nvidia (NVIDIA-hosted inference).
# NVIDIA_API_KEY=

# Window in days for the learner features (default 14, matches learner_features.window_days).
# FEATURE_WINDOW_DAYS=

# Set to 1 to let the hourly task post feedback to GitHub; unset = it only logs WOULD POST.
# VDEL_ALLOW_GITHUB_WRITE=

# Set to docker to grade student code in the vdel-grader container; it never falls back to a subprocess.
# VDEL_GRADING_SANDBOX=

# Name of the grading image when it is not the default vdel-grader:1.
# VDEL_GRADING_IMAGE=
